    "Change how notifications behave when daily daylight begins to decrease. This can help with Seasonal Affective Disorder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يمكنك تغيير طريقة عمل الإشعارات عندما يبدأ ضوء النهار اليومي في التناقص. قد يساعد ذلك في التعامل مع الاضطراب العاطفي الموسمي (SAD)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ändere das Verhalten von Mitteilungen, wenn das tägliche Tageslicht abzunehmen beginnt. Das kann bei saisonal-affektiver Störung (SAD) helfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cambia el comportamiento de las notificaciones cuando la luz natural diaria empieza a disminuir. Esto puede ayudar con el trastorno afectivo estacional (TAE)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Modifiez le comportement des notifications lorsque la lumière du jour commence à diminuer. Cela peut aider en cas de trouble affectif saisonnier (TAS)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica il comportamento delle notifiche quando la luce del giorno inizia a diminuire. Questo può aiutare con il disturbo affettivo stagionale (SAD)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "日々の日照時間が減り始めたときの通知の動作を変更します。季節性情動障害（SAD）の緩和に役立つことがあります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wijzig hoe meldingen zich gedragen wanneer het daglicht per dag begint af te nemen. Dit kan helpen bij een seizoensgebonden depressie (SAD)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zmień sposób działania powiadomień, gdy ilość światła dziennego zaczyna się zmniejszać. Może to pomóc w sezonowym zaburzeniu afektywnym (SAD)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "更改每日日照开始减少时的通知行为。这有助于缓解季节性情感障碍（SAD）。"
          }
        }
      }
    },
