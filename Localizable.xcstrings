    "Solstice tells you how much daylight there is today compared to yesterday." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُطلعك Solstice على مقدار ضوء النهار اليوم مقارنةً بالأمس."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solstice zeigt dir, wie viel Tageslicht es heute im Vergleich zu gestern gibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solstice te muestra cuánta luz natural hay hoy en comparación con ayer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solstice vous indique la quantité de lumière du jour aujourd’hui par rapport à hier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solstice ti dice quanta luce c'è oggi rispetto a ieri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solsticeは、今日の日照時間が昨日と比べてどれくらいかを教えてくれます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solstice laat je zien hoeveel daglicht er vandaag is vergeleken met gisteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
