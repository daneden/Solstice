    "Follow the sun's journey throughout the day" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تابِع رحلة الشمس على مدار اليوم"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verfolge den Weg der Sonne im Laufe des Tages"
          }
