        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affinché il Solstice calcoli la posizione del sole, deve accedere alla tua posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
