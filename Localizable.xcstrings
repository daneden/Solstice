            "value" : "Śledź wędrówkę słońca w ciągu dnia"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "跟随太阳一整天的旅程"
          }
        }
      }
    },
    "For savouring the minutes you have, or looking forward to the minutes you’ll gain." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "للاستمتاع بالدقائق التي لديك، أو التطلع إلى الدقائق التي ستكسبها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um die Minuten zu genießen, die du hast, oder dich auf die zu freuen, die du gewinnst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para saborear los minutos que tienes o ilusionarte con los que vas a ganar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour savourer les minutes dont vous disposez, ou attendre avec impatience celles que vous gagnerez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per assaporare i minuti che hai, o aspettare con ansia i minuti che guadagnerai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "今ある時間を味わうために、そしてこれから増えていく時間を心待ちにするために。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Om te genieten van de minuten die je hebt, of uit te kijken naar de minuten die je erbij krijgt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aby cieszyć się minutami, które masz, i z niecierpliwością wyczekiwać tych, które zyskasz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "用心品味你已拥有的每一分钟，也满怀期待即将收获的每一分钟。"
          }
        }
      }
    },
