    "**Thank you so much for your support.** Feel free to leave another tip in the future if you’re feeling generous." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "**شكرًا جزيلًا على دعمك.** لا تتردد في ترك إكرامية أخرى مستقبلًا إن كنت في مزاج للكرم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "**Vielen Dank für deine Unterstützung.** Wenn du magst, kannst du in Zukunft gerne noch ein weiteres Trinkgeld hinterlassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "**Muchísimas gracias por tu apoyo.** Si te sientes generoso, no dudes en dejar otra propina en el futuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "**Merci infiniment pour votre soutien.** N’hésitez pas à laisser un autre pourboire à l’avenir si le cœur vous en dit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Grazie mille per il tuo supporto.** Sentiti libero di lasciare un altro suggerimento in futuro se ti senti generoso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "**ご支援いただき、本当にありがとうございます。**もしよろしければ、今後またチップを送っていただけると嬉しいです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "**Heel erg bedankt voor je steun.** Voel je vrij om in de toekomst nog een fooi te geven als je je gul voelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "**Bardzo dziękujemy za wsparcie.** Jeśli w przyszłości poczujesz się hojnie, możesz zostawić kolejny napiwek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "**非常感谢你的支持。**如果日后你有兴致，欢迎再次留下打赏。"
          }
        }
      }
    },
