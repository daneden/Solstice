    "No daylight left today. The sun set %@ ago." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يتبقَّ ضوء نهار اليوم. غربت الشمس منذ %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Heute ist kein Tageslicht mehr übrig. Die Sonne ist vor %@ untergegangen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hoy ya no queda luz natural. El sol se puso hace %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il ne reste plus de lumière du jour aujourd’hui. Le soleil s’est couché il y a %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è rimasta più la luce del giorno oggi. Il sole è tramontato %@ fa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "今日はもう日照がありません。太陽は%@前に沈みました。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er is vandaag geen daglicht meer over. De zon is %@ geleden ondergegaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dziś nie ma już światła dziennego. Słońce zaszło %@ temu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "今天已没有日照了。太阳已在%@前落下。"
          }
        }
      }
    },
