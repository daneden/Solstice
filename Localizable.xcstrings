    "In order for Solstice to calculate the sun’s position, it needs to access your location." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لكي يتمكن Solstice من حساب موضع الشمس، يحتاج إلى الوصول إلى موقعك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Damit Solstice die Position der Sonne berechnen kann, benötigt die App Zugriff auf deinen Standort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para que Solstice pueda calcular la posición del sol, necesita acceder a tu ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour que Solstice puisse calculer la position du soleil, il doit accéder à votre position."
