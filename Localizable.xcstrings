        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "一日を通じた太陽の軌跡をたどります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Volg de reis van de zon gedurende de dag"
          }
        },
        "pl" : {
          "stringUnit" : {
