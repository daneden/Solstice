    "Locations are synced via iCloud. Delete or add new locations by using Solstice on Mac, iPhone, iPad, or Apple Vision Pro" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تجري مزامنة المواقع عبر iCloud. يمكنك حذف المواقع أو إضافة مواقع جديدة باستخدام Solstice على Mac أو iPhone أو iPad أو Apple Vision Pro"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Orte werden über iCloud synchronisiert. Orte lassen sich mit Solstice auf dem Mac, iPhone, iPad oder Apple Vision Pro löschen oder hinzufügen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las ubicaciones se sincronizan mediante iCloud. Elimina o añade nuevas ubicaciones usando Solstice en el Mac, iPhone, iPad o Apple Vision Pro"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les lieux sont synchronisés via iCloud. Supprimez ou ajoutez des lieux à l’aide de Solstice sur Mac, iPhone, iPad ou Apple Vision Pro"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le posizioni vengono sincronizzate tramite iCloud. Elimina o aggiungi nuove posizioni usando Solstice su Mac, iPhone, iPad o Apple Vision Pro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "場所はiCloud経由で同期されます。Mac、iPhone、iPad、またはApple Vision ProでSolsticeを使って、場所を削除したり新しく追加したりできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Locaties worden gesynchroniseerd via iCloud. Verwijder of voeg nieuwe locaties toe met Solstice op de Mac, iPhone, iPad of Apple Vision Pro"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lokalizacje są synchronizowane przez iCloud. Usuwaj lub dodawaj nowe lokalizacje, korzystając z Solstice na Macu, iPhonie, iPadzie lub Apple Vision Pro"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
