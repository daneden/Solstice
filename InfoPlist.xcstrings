    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يستخدم Solstice موقعك لحساب أوقات الشروق والغروب المحلية"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solstice verwendet deinen Standort, um die lokalen Zeiten für Sonnenauf- und -untergang zu berechnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Solstice uses your location to calculate local sunrise and sunset times"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solstice usa tu ubicación para calcular las horas locales de amanecer y puesta de sol"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solstice utilise votre position pour calculer les heures locales de lever et de coucher du soleil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solstice usa la tua posizione per calcolare gli orari locali di alba e tramonto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solsticeは、現地の日の出と日の入りの時刻を計算するために位置情報を使用します"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solstice gebruikt je locatie om de lokale tijden van zonsopkomst en zonsondergang te berekenen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solstice używa Twojej lokalizacji, aby obliczyć lokalne godziny wschodu i zachodu słońca"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solstice 使用你的位置来计算当地的日出和日落时间"
          }
        }
      }
    }
  },
  "version" : "1.3"
